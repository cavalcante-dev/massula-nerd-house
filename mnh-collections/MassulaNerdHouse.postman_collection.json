            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/usuario/listar/{{usuarioId}}", "host": ["{{baseUrl}}"], "path": ["usuario", "listar", "{{usuarioId}}"] }
          },
